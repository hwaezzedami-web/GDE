# =============================================================================
# Secrets des sources OMC — copier en .env.omc (droits 600, jamais versionné)
# Nom des variables : OMC_<CODE_SOURCE>_<NOM>, le code étant mis en majuscules
# et les caractères non alphanumériques remplacés par « _ ».
# Exemple pour une source de code HUAWEI-OMC-CENTRE :
# =============================================================================
# OMC_HUAWEI_OMC_CENTRE_USERNAME=compte_lecture_seule
# OMC_HUAWEI_OMC_CENTRE_PASSWORD=...
# OMC_HUAWEI_OMC_CENTRE_PRIVATE_KEY_PATH=/app/config/keys/huawei_centre
# OMC_ERICSSON_OMC_1_DSN=postgresql+psycopg://lecture:...@hote:5432/base
# Source Prometheus PROM-HUAWEI protégée (basic auth ou jeton) :
# OMC_PROM_HUAWEI_USERNAME=lecture
# OMC_PROM_HUAWEI_PASSWORD=...
# OMC_PROM_HUAWEI_BEARER_TOKEN=...
# Variante fichier (secrets Docker) : OMC_<CODE>_PASSWORD_FILE=/run/secrets/...

# Réception des alarmes Huawei par traps SNMP (interface nord du MAE) : service snmp-trap-huawei
# SNMPv3 (recommandé) — mêmes valeurs que celles saisies côté MAE pour la destination des traps :
# OMC_HUAWEI_SNMP_V3_USER=...
# OMC_HUAWEI_SNMP_V3_AUTH_PROTOCOL=SHA          # SHA, SHA-256, SHA-512 ou MD5
# OMC_HUAWEI_SNMP_V3_AUTH_PASSWORD=...
# OMC_HUAWEI_SNMP_V3_PRIV_PROTOCOL=AES          # AES ou DES
# OMC_HUAWEI_SNMP_V3_PRIV_PASSWORD=...
# OMC_HUAWEI_SNMP_V3_ENGINE_ID=0x...            # engine ID du MAE : obligatoire pour des TRAP v3, inutile pour des INFORM (recommandés)
# SNMPv2c (à défaut) :
# OMC_HUAWEI_SNMP_COMMUNITY=...
