# =============================================================================
# GSM Supervision — configuration (copier en .env ; NE JAMAIS versionner .env)
# =============================================================================

# --- Base de données (conteneur db) -----------------------------------------
POSTGRES_DB=gsm_supervision
POSTGRES_USER=gsm
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_long_et_aleatoire

# Hors Docker uniquement (sinon construit automatiquement par docker-compose.yml) :
# DATABASE_URL=postgresql+psycopg://gsm:<mot_de_passe>@localhost:5432/gsm_supervision

# --- Sécurité -----------------------------------------------------------------
ENVIRONMENT=production
# 32 caractères minimum : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGER_MOI
ACCESS_TOKEN_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=10
# Origines autorisées si l'interface est servie depuis un autre domaine (sinon laisser vide)
CORS_ORIGINS=

# Premier administrateur : créé au démarrage UNIQUEMENT si aucun utilisateur n'existe.
# Changement de mot de passe imposé à la 1re connexion. Vider ces lignes ensuite.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGER_MOI_Provisoire-2026

# --- Application ----------------------------------------------------------------
LOG_LEVEL=INFO
API_WORKERS=2
EXPORT_MAX_ROWS=200000
MAP_MAX_POINTS=100000

# --- Interface web -----------------------------------------------------------------
# Adresse par laquelle les utilisateurs ouvrent l'application (liens de Prometheus/Alertmanager)
PUBLIC_URL=http://localhost:8080
WEB_BIND=0.0.0.0
WEB_PORT=8080
# Fond de carte : OpenStreetMap par défaut (accès Internet requis depuis les postes).
# Réseau isolé : serveur de tuiles interne (et adapter la CSP dans deploy/nginx/gsm.conf).
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION="&copy; contributeurs OpenStreetMap"
# Fond par défaut : offline = carte de l'Algérie embarquée (recommandé, sans Internet)
#                    auto = OpenStreetMap en ligne, bascule si injoignable ; osm = OpenStreetMap uniquement
# L'utilisateur peut toujours changer de fond (icône des couches). OpenStreetMap public n'est pas
# prévu pour un usage intensif (politique d'usage des tuiles) : préférer un serveur de tuiles interne.
VITE_BASEMAP=offline
VITE_REFRESH_SECONDS=60

# --- Collecte -----------------------------------------------------------------------
# Répertoire hôte où les OMC déposent leurs exports (monté en lecture seule)
OMC_EXPORT_DIR=./omc-exports
# Répertoire hôte de dépôt du référentiel de sites (KMZ / Excel…), import automatique optionnel
REFERENCE_DROP_DIR=./referentiel-depot
