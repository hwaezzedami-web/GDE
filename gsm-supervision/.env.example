# Copier ce fichier en .env (non versionné) puis remplir les valeurs.
# Les variantes *_FILE (ex. JWT_SECRET_FILE=/run/secrets/jwt) sont acceptées pour les secrets Docker.

# Base de données
POSTGRES_DB=gsm
POSTGRES_USER=gsm
POSTGRES_PASSWORD=A_COMPLETER

# Secret de signature des jetons (32 caractères minimum ; l'API refuse de démarrer sinon).
# Générer par exemple avec : openssl rand -base64 48
JWT_SECRET=A_COMPLETER

# Compte administrateur créé au premier démarrage (changement de mot de passe imposé à la 1re connexion)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=A_COMPLETER

# Sécurité de connexion
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
JWT_EXPIRE_MINUTES=480

# Exports
EXPORT_MAX_ROWS=100000

# Port HTTP publié par l'API (phase 1 ; nginx prendra le relais en phase 4)
API_PORT=8000
