config/exporters/*.json
*.kmz

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/

# Divers
logs/
*.log
.DS_Store
