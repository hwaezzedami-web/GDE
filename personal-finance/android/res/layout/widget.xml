<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#A9C9BA" android:textSize="12sp" android:singleLine="true" />
    <TextView android:id="@+id/w_rate" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#F3FAF6" android:textSize="22sp" android:textStyle="bold" android:singleLine="true" />
    <TextView android:id="@+id/w_cash" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#F3FAF6" android:textSize="14sp" android:singleLine="true" />
    <TextView android:id="@+id/w_eur" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#E2B65C" android:textSize="14sp" android:singleLine="true" />
    <TextView android:id="@+id/w_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#A9C9BA" android:textSize="11sp" android:singleLine="true" />
</LinearLayout>
